install.packages(c("devtools", "testthat", "roxygen2")) # если еще не установлены
library(devtools)
library(testthat)
devtools::document()  # автоматически обновит файл NAMESPACE и создаст папку man/
devtools::test()      # запустит тесты
devtools::check()     # проверит пакет на отсутствие ошибок (0 errors | 0 warnings)
devtools::document()
devtools::document()  # автоматически обновит файл NAMESPACE и создаст папку man/
devtools::test()      # запустит тесты
devtools::check()     # проверит пакет на отсутствие ошибок (0 errors | 0 warnings)
options(buildtools.check = function(action) TRUE)
devtools::check(build_args = "--no-build-vignettes")
devtools::document()  # автоматически обновит файл NAMESPACE и создаст папку man/
devtools::test()      # запустит тесты
devtools::check(build_args = "--no-build-vignettes")
